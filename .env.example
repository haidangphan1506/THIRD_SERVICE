NODE_ENV=development
PORT=3000

# Optional local DB: from repo root run `bun podman:up` or `bun compose:up`, then align POSTGRES_* / DATABASE_URL below with that container.
# Compose maps DB to host port 5433 by default (avoids clash with PostgreSQL already on 5432). Use 5432 here if your DB listens there.
# Match these to your real PostgreSQL install. Default "postgres"/"postgres" only works if you set that password.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=backends_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Must use the same user/password/host/port/db as above. Special chars in password must be URL-encoded in DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/backends_db

# JWT: dùng hai secret dạng UUID (v4) — tạo mới: `node -e "console.log(require('crypto').randomUUID())"`
JWT_ACCESS_SECRET=a1b2c3d4-e5f6-4789-a012-3456789abcdef
JWT_REFRESH_SECRET=b2c3d4e5-f6a7-4890-b123-456789abcdef0
# TTL (giây): access 3h, refresh 7d (có thể bỏ dòng nếu dùng mặc định trong code)
JWT_ACCESS_EXPIRES_SECONDS=10800
JWT_REFRESH_EXPIRES_SECONDS=604800
# Tương thích cũ: nếu chưa set JWT_ACCESS_SECRET thì fallback JWT_SECRET
# JWT_SECRET=

# Redis: dùng REDIS_URL hoặc REDIS_HOST / REDIS_PORT / REDIS_PASSWORD
# docker-compose trong repo map Redis ra host cổng 6380 (tránh trùng Redis local 6379)
REDIS_HOST=localhost
REDIS_PORT=6380
# REDIS_PASSWORD=
# REDIS_URL=redis://:password@localhost:6379/0

# SMTP (nodemailer): production bắt buộc có MAIL_HOST + MAIL_PORT + MAIL_FROM.
# development/test: có thể để trống — forgot-password vẫn 200, token lưu Redis, server log cảnh báo kèm link reset.
MAIL_SERVICE=gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=true
MAIL_USER=chienbinhthephai@gmail.com
MAIL_PASS=ldkhoemqdenozvnz
MAIL_FROM=chienbinhthephai@gmail.com

# Trang reset mật khẩu (frontend): ví dụ admin web — email sẽ chứa link `${PASSWORD_RESET_URL_BASE}/reset-password?token=...`
PASSWORD_RESET_URL_BASE=http://localhost:3000
